+++ b/src/Interpreters/tests/gtest_partitioned_hash_join.cpp
@@ -210,6 +210,54 @@ void probeAndCheck(BuiltJoin & built, size_t distinct_keys, size_t duplicates, s
 
 }
 
+TEST(PartitionedHashJoin, WideCounterFallbackParity)
+{
+    /// The narrow UInt32 histogram/offset counters engage by default (every test build fits
+    /// UInt32); force the UInt64 fallback and check the two counter shapes agree end to end.
+    constexpr size_t distinct_keys = 200000;
+    constexpr size_t duplicates = 2;
+
+    auto narrow = buildJoin(distinct_keys, duplicates, /*num_threads=*/4);
+    probeAndCheck(narrow, distinct_keys, duplicates, /*misses=*/100);
+
+    const Block left_header = twoColumnBlock("k", "probe_id", {}, {});
+    const Block right_header = twoColumnBlock("rk", "build_id", {}, {});
+    BuiltJoin wide;
+    wide.table_join = makeTableJoin(left_header, right_header, JoinKind::Inner);
+    wide.join = std::make_shared<PartitionedHashJoin>(wide.table_join, std::make_shared<const Block>(right_header), 4);
+    wide.join->setNarrowCountersForTests(false);
+    {
+        std::vector<UInt64> keys;
+        std::vector<UInt64> ids;
+        UInt64 id = 0;
+        for (size_t i = 0; i < distinct_keys; ++i)
+        {
+            for (size_t d = 0; d < duplicates; ++d)
+            {
+                keys.push_back(i * 2654435761ULL + 1);
+                ids.push_back(id++);
+                if (keys.size() == block_rows)
+                {
+                    EXPECT_TRUE(wide.join->addBlockToJoin(twoColumnBlock("rk", "build_id", keys, ids), /*check_limits=*/true));
+                    keys.clear();
+                    ids.clear();
+                }
+            }
+        }
+        if (!keys.empty())
+            EXPECT_TRUE(wide.join->addBlockToJoin(twoColumnBlock("rk", "build_id", keys, ids), /*check_limits=*/true));
+    }
+    wide.join->onBuildPhaseFinish();
+    wide.join->runPostBuildPhase();
+    probeAndCheck(wide, distinct_keys, duplicates, /*misses=*/100);
+
+    /// Same partition plan and identical per-leaf row distribution from both counter shapes.
+    const auto narrow_stats = narrow.join->getBuildStats();
+    const auto wide_stats = wide.join->getBuildStats();
+    EXPECT_EQ(narrow_stats.partitions, wide_stats.partitions);
+    EXPECT_TRUE(narrow_stats.leaf_row_counts == wide_stats.leaf_row_counts);
+}
+
