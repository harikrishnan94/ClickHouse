<!-- Minimal single-file server config for the parity harness.
     Placeholders: @TCP_PORT@ @HTTP_PORT@ @PATH@ (absolute server dir).
     Deliberately: listen 127.0.0.1 only, non-default ports, explicit
     query_log (engagement assertions need it), NO keeper/zookeeper. -->
<clickhouse>
    <logger>
        <level>information</level>
        <log>@PATH@/clickhouse-server.log</log>
        <errorlog>@PATH@/clickhouse-server.err.log</errorlog>
        <size>200M</size>
        <count>2</count>
    </logger>

    <listen_host>127.0.0.1</listen_host>
    <tcp_port>@TCP_PORT@</tcp_port>
    <http_port>@HTTP_PORT@</http_port>

    <path>@PATH@/data/</path>
    <tmp_path>@PATH@/tmp/</tmp_path>
    <user_files_path>@PATH@/user_files/</user_files_path>
    <format_schema_path>@PATH@/format_schemas/</format_schema_path>

    <mark_cache_size>268435456</mark_cache_size>

    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_log>

    <users>
        <default>
            <password></password>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>
    <profiles>
        <default>
        </default>
    </profiles>
    <quotas>
        <default>
        </default>
    </quotas>
</clickhouse>
